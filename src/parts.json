"ba": "<div class=\"ba reveal\" id=\"ba\">\n      <img src=\"assets/img/r/after_day.jpg\" alt=\"Utána: a gardrób a ZENIT felső szekrénnyel\">\n      <div class=\"before\"><img src=\"assets/img/r/before_day.jpg\" alt=\"Előtte: üres sáv a szekrény fölött\"><div class=\"mask\"></div></div>\n      <div class=\"handle\" id=\"baHandle\"></div>\n      <span class=\"lbl\" style=\"left:18px\">Előtte</span><span class=\"lbl\" style=\"right:18px\">Utána</span>\n      <span class=\"render-tag\">Látványterv</span>\n    </div>\n    ",
"stats": "<div class=\"stats reveal\">\n      <div class=\"stat\"><b>~1<small>m³</small></b><span>extra tárhely egy 250 cm-es szekrény fölött</span></div>\n      <div class=\"stat\"><b>10<small>mm</small></b><span>marad a plafonig – milliméterre tervezve</span></div>\n      <div class=\"stat\"><b>0</b><span>furat a falban – csak a szekrényedhez rögzül, bérlakásban is</span></div>\n      <div class=\"stat\"><b>1<small>nap</small></b><span>alatt felszerelhető, szétszedhető, költözéskor viszed</span></div>\n    </div>\n  ",
"explode": "<section class=\"explode\">\n  <div class=\"stage\" id=\"explode\">\n    <div class=\"wrap sticky\">\n      <div>\n        <div class=\"kicker\">02 — Felépítés</div>\n        <h2 class=\"h2\" style=\"margin-top:18px\">Egy bútor. <em>Harminc gondos részlet.</em></h2>\n        <ol>\n          <li><span><b>Egy korpusz, egybefüggő tetővel.</b> Nincsenek toldások, nincs látható illesztés.</span></li>\n          <li><span><b>Tipli és konfirmát kötés.</b> Ragasztó nélkül szilárd – és bármikor szétszedhető.</span></li>\n          <li><span><b>Fékes Häfele pántok.</b> Az ajtó csendben, puhán zár.</span></li>\n          <li><span><b>2 mm-es ajtóél.</b> Kopásálló, lekerekített, kézbe simuló.</span></li>\n        </ol>\n      </div>\n      <div class=\"canvas\"><img src=\"assets/img/r/exploded.jpg\" alt=\"A ZENIT robbantott nézete\"><span class=\"render-tag\">Látványterv · robbantott nézet</span></div>\n    </div>\n  </div>\n</section>\n\n",
"cfgshell": "<div class=\"cfg-shell\">\n    <div class=\"viewer\">\n      <div class=\"toolbar\"><div class=\"seg\" id=\"envSeg\"><button class=\"on\" data-env=\"room\">Szobában</button><button data-env=\"studio\">Stúdió</button></div></div>\n      <div class=\"tools\">\n        <button class=\"icon-btn\" id=\"btnOpen\" title=\"Ajtók nyitása / zárása\">◫</button>\n        <button class=\"icon-btn\" id=\"btnReset\" title=\"Nézet alaphelyzetbe\">⟲</button>\n        <button class=\"icon-btn\" id=\"btnAR\" title=\"Nézd meg a szobádban (AR) – hamarosan\">AR</button>\n        <button class=\"icon-btn\" id=\"btnFull\" title=\"Teljes képernyő\">⤢</button>\n      </div>\n      <canvas id=\"cfg3d\" aria-label=\"A ZENIT élő 3D modellje\"></canvas>\n      <div class=\"dims\"><b id=\"dimW\">250</b>cm × <b id=\"dimH\">53</b>cm × <b id=\"dimD\">60</b>cm</div>\n      <div class=\"hint\">Forgasd · nagyíts · kattints az ajtóra</div>\n    </div>\n\n    <aside class=\"panel\">\n      <div class=\"scroll\">\n        <div class=\"step\">\n          <h4>Méret <small>1 / 6</small></h4>\n          <div class=\"val\">Saját szekrényed – <a href=\"#\" id=\"baseCol\" style=\"border-bottom:1px solid var(--line)\">alatta lévő szekrény színe: kasmír</a></div>\n          <div class=\"row\"><label>Szélesség <b><span id=\"wVal\">250</span> cm</b></label><input type=\"range\" id=\"w\" min=\"60\" max=\"280\" value=\"250\"></div>\n          <div class=\"row\"><label>Belmagasság <b><span id=\"ceilVal\">259</span> cm</b></label><input type=\"range\" id=\"ceil\" min=\"220\" max=\"320\" value=\"259\"></div>\n          <div class=\"row\"><label>Meglévő szekrény magassága <b><span id=\"baseVal\">205</span> cm</b></label><input type=\"range\" id=\"baseH\" min=\"150\" max=\"260\" value=\"205\"></div>\n          <div class=\"row\"><label>Mélység</label><div class=\"opts\" id=\"depthOpts\"><button class=\"opt\" data-d=\"35\">35 cm</button><button class=\"opt\" data-d=\"45\">45 cm</button><button class=\"opt on\" data-d=\"60\">60 cm</button></div></div>\n        </div>\n        <div class=\"step\">\n          <h4>Ajtók <small>2 / 6</small></h4>\n          <div class=\"val\">Javasolt: <span id=\"doorRec\">5</span> ajtó (max. 60 cm / ajtó)</div>\n          <div class=\"opts\" id=\"doorOpts\"></div>\n          <div class=\"opts\" id=\"splitOpts\"><button class=\"opt on\" data-s=\"eq\">Egyenlő osztás</button><button class=\"opt\" data-s=\"sym\">Szimmetrikus, középen szélesebb</button></div>\n        </div>\n        <div class=\"step\">\n          <h4>Szín és textúra <small>3 / 6</small></h4>\n          <div class=\"tabs\" id=\"partTabs\"><button class=\"on\" data-part=\"ajto\">Ajtók</button><button data-part=\"korpusz\">Korpusz</button><button data-part=\"belso\">Belső</button></div>\n          <div class=\"sw-group\">Uni színek</div>\n          <div class=\"sw\" id=\"swUni\"></div>\n          <div class=\"sw-group\">Fa · ZENIT Natúr</div>\n          <div class=\"sw\" id=\"swWood\"></div>\n          <div class=\"sw-group\">Kő és len</div>\n          <div class=\"sw\" id=\"swStone\"></div>\n          <div class=\"hex\"><i id=\"hexPrev\" style=\"background:#CDBFAE\"></i><input id=\"hexIn\" value=\"#CDBFAE\" maxlength=\"7\" aria-label=\"Egyedi HEX színkód\"></div>\n          <div class=\"opts\" id=\"finOpts\"><button class=\"opt on\" data-f=\"matt\">Matt</button><button class=\"opt\" data-f=\"satin\">Selyemfény</button><button class=\"opt\" data-f=\"gloss\">Magasfény</button></div>\n        </div>\n        <div class=\"step\">\n          <h4>Fogantyú <small>4 / 6</small></h4>\n          <div class=\"cards\" id=\"handles\">\n            <button class=\"card on\" data-h=\"edge\"><div class=\"pic\"><svg width=\"70\" height=\"20\"><path d=\"M2 4h66v6a6 6 0 0 1-6 6H8a6 6 0 0 1-6-6z\" fill=\"none\" stroke=\"#EDE6DA\"/></svg></div><b>Élfogantyú</b><span>lekerekített, 192 / 320 mm</span></button>\n            <button class=\"card\" data-h=\"bar\"><div class=\"pic\"><svg width=\"70\" height=\"20\"><path d=\"M6 10h58\" stroke=\"#EDE6DA\" stroke-width=\"3\" stroke-linecap=\"round\"/></svg></div><b>Rúd</b><span>vékony, 320 mm</span></button>\n            <button class=\"card\" data-h=\"knob\"><div class=\"pic\"><svg width=\"70\" height=\"20\"><circle cx=\"35\" cy=\"10\" r=\"7\" fill=\"none\" stroke=\"#EDE6DA\"/></svg></div><b>Gomb / bőrfül</b><span>diszkrét részlet</span></button>\n            <button class=\"card\" data-h=\"push\"><div class=\"pic\"><svg width=\"70\" height=\"20\"><path d=\"M10 10h50\" stroke=\"#857B70\" stroke-dasharray=\"3 3\"/></svg></div><b>Nyomásra nyíló</b><span>fogantyú nélkül</span></button>\n          </div>\n          <div class=\"opts\" id=\"hcol\"><button class=\"opt on\" data-c=\"#C9C6C0\">Alu elox</button><button class=\"opt\" data-c=\"#222\">Matt fekete</button><button class=\"opt\" data-c=\"#B08D57\">Bronz</button><button class=\"opt\" data-c=\"#7A4E2D\">Bőr</button></div>\n        </div>\n        <div class=\"step\">\n          <h4>Belső <small>5 / 6</small></h4>\n          <div class=\"val\">Polc rekeszenként</div>\n          <div class=\"opts\" id=\"shelfOpts\"></div>\n        </div>\n        <div class=\"step\">\n          <h4>Extrák <small>6 / 6</small></h4>\n          <div class=\"toggle\"><span>Belső LED-világítás<small>ajtónyitásra, melegfehér</small></span><button class=\"sw-t on\" id=\"xLed\"></button></div>\n          <div class=\"toggle\"><span>Plafonzáró takaróléc<small>beépített hatás</small></span><button class=\"sw-t\" id=\"xTrim\"></button></div>\n          <div class=\"toggle\"><span>Tárolódobozok<small>lenvászon, rekeszre méretezve</small></span><button class=\"sw-t\" id=\"xBox\"></button></div>\n          <div class=\"toggle\"><span>Fékes Häfele pántok<small>alapfelszereltség</small></span><button class=\"sw-t on\" disabled></button></div>\n        </div>\n      </div>\n      <div class=\"summary\" id=\"terv\">\n        <div class=\"price\"><b id=\"price\">229 900 Ft</b><span>Becsült ár</span></div>\n        <div class=\"meta\">Gyártás 3–4 hét · szállítás és szerelés országosan · ZENIT Örökgarancia</div>\n        <div class=\"acts\">\n          <a class=\"btn fill full\" href=\"#\">Ajánlatot kérek <span class=\"arrow\"></span></a>\n          <a class=\"btn\" href=\"#\">Tervező hív vissza</a>\n          <a class=\"btn\" href=\"#\">Megrendelem <span class=\"demo\" style=\"margin-left:4px\">Demó</span></a>\n        </div>\n        <div class=\"links\"><a href=\"#\">Link másolása</a><a href=\"#\">PDF</a><a href=\"#\">Terv mentése</a></div>\n      </div>\n    </aside>\n  </div>\n",
"howgrid": "<div class=\"how-grid reveal\">\n      <div><div class=\"n\">01</div><h3>Megtervezed</h3><p>A tervezőben pár perc alatt összeállítod – vagy egy belsőépítészünk segít.</p></div>\n      <div><div class=\"n\">02</div><h3>Méretre gyártjuk</h3><p>Hazai lapszabászatban, milliméterre vágva, gépi élzárással, előfúrva.</p></div>\n      <div><div class=\"n\">03</div><h3>Kiszállítjuk</h3><p>Lapra szerelve, gondosan csomagolva, egyeztetett időpontban.</p></div>\n      <div><div class=\"n\">04</div><h3>Felszereljük</h3><p>Egy nap alatt, falfúrás nélkül. Te már csak az ajtót csukod be – puhán.</p></div>\n    </div>\n  ",
"faq": "<details open><summary>Bármilyen szekrényre jó?</summary><p>Igen, ha a teteje sík és teherbíró. A tervezőben megadod a szekrényed és a plafonod magasságát, mi pedig milliméterre méretezzük.</p></details>\n      <details><summary>Kell fúrni a falba?</summary><p>Nem. A ZENIT négy csavarral a meglévő szekrényed tetejéhez rögzül – bérlakásban is nyugodtan választhatod.</p></details>\n      <details><summary>Miből készül?</summary><p>Fa alapú, laminált bútorlapból, gépi ABS élzárással. A ZENIT Natúr változat valódi tölgy- vagy diófurnérral készül.</p></details>\n      <details><summary>Mennyi idő alatt készül el?</summary><p>Általában 3–4 hét a rendeléstől a felszerelésig; a szerelés egy nap.</p></details>\n      <details><summary>Szétszedhető, ha költözöm?</summary><p>Igen. A tipli- és konfirmátkötés ragasztó nélküli, így a ZENIT szétszedhető és máshol újra összerakható.</p></details>\n    ",
"trust": "<div class=\"trust\">\n      <div><b>Häfele vasalat</b><span>Fékes, 110°-os kivetőpántok minden ajtón.</span></div>\n      <div><b>Magyar tervezés</b><span>Itthon tervezve, hazai lapszabászatban gyártva.</span></div>\n      <div><b>Méretre szabva</b><span>60–280 cm, 1–6 ajtó, a plafonodhoz igazítva.</span></div>\n      <div><b>Bérlakásbarát</b><span>Csak a szekrényhez rögzül, a falat nem fúrjuk.</span></div>\n    </div>\n  ",
"matgrid": "<div class=\"mat-grid reveal\">\n      <div class=\"tile big\"><img class=\"fill\" src=\"assets/img/r/tex_oak.jpg\" alt=\"Natúr tölgy furnér\"><div class=\"cap\"><div class=\"h3\">ZENIT Natúr</div><p>Valódi tölgyfurnér – minden ajtó erezete egyedi.</p></div><span class=\"render-tag\">Látványterv</span></div>\n      <div class=\"tile\"><img class=\"fill\" src=\"assets/img/r/macro_handle.jpg\" alt=\"Lekerekített alu élfogantyú\"><div class=\"cap\"><div class=\"h3\">Kézbe simuló</div><p>Lekerekített, eloxált alumínium élfogantyú.</p></div></div>\n      <div class=\"tile\"><img class=\"fill\" src=\"assets/img/r/open_led.jpg\" alt=\"Nyitott ajtók, fékes pántok\" style=\"object-position:70% 20%\"><div class=\"cap\"><div class=\"h3\">Csendes zárás</div><p>Häfele fékes pántok, ajtónként.</p></div></div>\n      <div class=\"tile\"><img class=\"fill\" src=\"assets/img/r/tex_linen.jpg\" alt=\"Len textúra\"><div class=\"cap\"><div class=\"h3\">Len és kő</div><p>Különleges textúrák a merész belsőkhöz.</p></div></div>\n      <div class=\"tile\"><img class=\"fill\" src=\"assets/img/r/macro_edge.jpg\" alt=\"2 mm-es ajtóél\"><div class=\"cap\"><div class=\"h3\">Precíz élek</div><p>Gépi élzárás, 2 mm az ajtókon.</p></div></div>\n    </div>\n    "
